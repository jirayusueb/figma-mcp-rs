{
  "name": "figma-mcp-rs-plugin",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "concurrently \"vite build --watch\" \"vite build --watch -c vite.config.main.ts\"",
    "build": "vite build && vite build -c vite.config.main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@kobalte/core": "^0.13.14",
    "cva": "1.0.0-beta.4",
    "solid-js": "^1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "concurrently": "^9",
    "tailwindcss": "^4.3.3",
    "typescript": "^7",
    "vite": "^7",
    "vite-plugin-singlefile": "^2",
    "vite-plugin-solid": "^1"
  }
}
